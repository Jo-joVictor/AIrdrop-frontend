# Deployed MerkleAirdrop contract on Sepolia (required)
VITE_AIRDROP_ADDRESS=

# Free project id from https://cloud.walletconnect.com (needed for WalletConnect wallets)
VITE_WALLETCONNECT_PROJECT_ID=

# Optional: your own Sepolia RPC URL (Alchemy, Infura...). Falls back to a public RPC.
VITE_SEPOLIA_RPC_URL=
